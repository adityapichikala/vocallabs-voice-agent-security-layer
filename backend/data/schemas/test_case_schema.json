{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TestCaseSchema",
  "type": "object",
  "required": [
    "id",
    "category",
    "title",
    "description",
    "audio_filename",
    "dialogue",
    "expected_ground_truth"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^TC-[0-9]{2}$" },
    "category": {
      "type": "string",
      "enum": ["CLEAN_CALL", "HALLUCINATION", "PROMISES_LEDGER", "HINGLISH_CODE_SWITCH", "SAFETY_ESCALATION"]
    },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "audio_filename": { "type": "string" },
    "duration_seconds": { "type": "number" },
    "dialogue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["turn_index", "speaker", "text", "start_time", "end_time"],
        "properties": {
          "turn_index": { "type": "integer" },
          "speaker": { "type": "string", "enum": ["agent", "customer"] },
          "text": { "type": "string" },
          "start_time": { "type": "number" },
          "end_time": { "type": "number" },
          "language": { "type": "string" }
        }
      }
    },
    "expected_ground_truth": {
      "type": "object",
      "required": ["expected_flags", "expected_promises", "expected_handoff", "expected_verdict"],
      "properties": {
        "expected_flags": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["turn_index", "flag_type", "severity"],
            "properties": {
              "turn_index": { "type": "integer" },
              "flag_type": { "type": "string" },
              "severity": { "type": "string" },
              "kb_fact_id": { "type": ["string", "null"] }
            }
          }
        },
        "expected_promises": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["turn_index", "target_entity", "is_authorized"],
            "properties": {
              "turn_index": { "type": "integer" },
              "target_entity": { "type": "string" },
              "is_authorized": { "type": "boolean" }
            }
          }
        },
        "expected_handoff": { "type": "boolean" },
        "expected_verdict": { "type": "string", "enum": ["PASS", "FAIL_FLAGGED", "ESCALATED"] }
      }
    }
  }
}
